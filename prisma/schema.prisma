// Mandi Relay — data model
//
// One database: Supabase Postgres. Prisma owns the tables; Supabase owns
// authentication (phone OTP) and the Row Level Security policies in
// `supabase/policies.sql`. Enum-like columns are stored as strings so the model
// stays portable across Postgres versions; the canonical values live in
// `src/lib/domain.ts` and are validated in `src/lib/schemas.ts`.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String   @id @default(uuid())
  // Supabase auth.users.id — the phone number proves this account.
  authUserId    String?  @unique
  phone         String   @unique
  name          String
  role          String // FARMER | BUYER | TRANSPORTER | ADMIN
  // Only the local development provider stores a password; Supabase users use OTP.
  passwordHash  String?
  language      String   @default("en") // en | hi | pa
  email         String?
  state         String?
  district      String?
  village       String?
  lat           Float?
  lng           Float?
  avatarUrl     String?
  verified      Boolean  @default(false)
  verificationNote String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  farm            Farm?
  business        BusinessProfile?
  transporter     TransporterProfile?
  listings        Listing[]
  offers          Offer[]              @relation("BuyerOffers")
  auctions        Auction[]
  bids            Bid[]
  buyerOrders     Order[]              @relation("BuyerOrders")
  farmerOrders    Order[]              @relation("FarmerOrders")
  notifications   Notification[]
  voiceSessions   VoiceSession[]
  deliveryRequests DeliveryRequest[]
  deliveryQuotes  DeliveryQuote[]
  deliveries      Delivery[]           @relation("TransporterDeliveries")
  auditLogs       AuditLog[]
  sessions        Session[]

  @@index([role])
  @@index([district])
}

model Farm {
  id              String   @id @default(uuid())
  userId          String   @unique
  farmName        String
  sizeAcres       Float?
  primaryCrops    String   @default("[]") // JSON array
  farmingPractice String?
  verificationStatus String @default("UNVERIFIED") // UNVERIFIED | PENDING | VERIFIED
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model BusinessProfile {
  id                  String   @id @default(uuid())
  userId              String   @unique
  businessName        String
  businessType        String // RETAILER | RESTAURANT | WHOLESALER | PROCESSOR | OTHER
  gstin               String?
  preferredCommodities String  @default("[]") // JSON array
  typicalQuantityKg   Float?
  deliveryLocations   String   @default("[]") // JSON array
  verificationStatus  String   @default("UNVERIFIED")
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
  user                User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model TransporterProfile {
  id              String   @id @default(uuid())
  userId          String   @unique
  vehicleType     String // PICKUP | TEMPO | TRUCK_6W | TRUCK_10W
  capacityKg      Float
  registrationNo  String?
  serviceAreas    String   @default("[]") // JSON array
  ratePerKm       Float?
  verificationStatus String @default("UNVERIFIED")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Category {
  id       String    @id @default(uuid())
  slug     String    @unique
  name     String
  nameHi   String
  namePa   String?
  icon     String?
  sortOrder Int      @default(0)
  listings Listing[]
}

model Listing {
  id            String   @id @default(uuid())
  farmerId      String
  categoryId    String
  commodity     String
  variety       String?
  quantity      Float
  availableQuantity Float // decrements as orders are confirmed
  unit          String   @default("kg")
  askingPrice   Float
  currency      String   @default("INR")
  availableFrom DateTime
  location      String
  district      String
  state         String
  lat           Float?
  lng           Float?
  description   String?
  imageUrl      String?
  grade         String? // only shown when the farmer supplies it
  gradeVerified Boolean  @default(false)
  pickupOnly    Boolean  @default(false)
  status        String   @default("ACTIVE") // DRAFT | ACTIVE | RESERVED | SOLD | PAUSED
  moderationStatus String @default("APPROVED") // APPROVED | PENDING | REJECTED
  source        String   @default("MANUAL") // MANUAL | VOICE
  viewCount     Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  farmer     User           @relation(fields: [farmerId], references: [id], onDelete: Cascade)
  category   Category       @relation(fields: [categoryId], references: [id])
  images     ListingImage[]
  offers     Offer[]
  auction    Auction?
  orders     Order[]
  deliveries DeliveryRequest[]

  @@index([status, categoryId])
  @@index([farmerId])
  @@index([district])
  @@index([commodity])
}

model ListingImage {
  id        String @id @default(uuid())
  listingId String
  url       String
  alt       String?
  sortOrder Int    @default(0)
  listing   Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)
}

// An Offer doubles as a counteroffer: `parentOfferId` points at the offer that
// was countered, and `actorRole` records who made this move in the thread.
model Offer {
  id            String   @id @default(uuid())
  listingId     String
  buyerId       String
  quantity      Float
  pricePerUnit  Float
  currency      String   @default("INR")
  message       String?
  pickupPreference String @default("PICKUP") // PICKUP | DELIVERY
  deliveryLocation String?
  requestsNegotiation Boolean @default(false)
  status        String   @default("PENDING") // PENDING | COUNTERED | ACCEPTED | REJECTED | WITHDRAWN
  actorRole     String   @default("BUYER") // BUYER | FARMER
  parentOfferId String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  listing  Listing  @relation(fields: [listingId], references: [id], onDelete: Cascade)
  buyer    User     @relation("BuyerOffers", fields: [buyerId], references: [id], onDelete: Cascade)
  parent   Offer?   @relation("OfferThread", fields: [parentOfferId], references: [id])
  replies  Offer[]  @relation("OfferThread")
  order    Order?

  @@index([listingId, status])
  @@index([buyerId])
}

model Auction {
  id            String   @id @default(uuid())
  listingId     String   @unique
  farmerId      String
  quantity      Float
  startingPrice Float
  minIncrement  Float    @default(1)
  startsAt      DateTime
  endsAt        DateTime
  status        String   @default("LIVE") // SCHEDULED | LIVE | CLOSED | AWARDED | CANCELLED
  pickupNote    String?
  buyerCriteria String?
  awardedBidId  String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  listing Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)
  farmer  User    @relation(fields: [farmerId], references: [id], onDelete: Cascade)
  bids    Bid[]

  @@index([status, endsAt])
}

model Bid {
  id        String   @id @default(uuid())
  auctionId String
  buyerId   String
  amount    Float // price per unit
  quantity  Float
  createdAt DateTime @default(now())

  auction Auction @relation(fields: [auctionId], references: [id], onDelete: Cascade)
  buyer   User    @relation(fields: [buyerId], references: [id], onDelete: Cascade)

  @@index([auctionId, amount])
}

model Order {
  id             String   @id @default(uuid())
  orderNo        String   @unique
  listingId      String
  farmerId       String
  buyerId        String
  offerId        String?  @unique
  auctionId      String?
  quantity       Float
  pricePerUnit   Float
  grossValue     Float
  transportCost  Float    @default(0)
  platformFee    Float    @default(0)
  netToFarmer    Float
  status         String   @default("CONFIRMED") // CONFIRMED | IN_TRANSIT | DELIVERED | COMPLETED | CANCELLED
  pickupPreference String @default("PICKUP")
  notes          String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  listing Listing @relation(fields: [listingId], references: [id])
  farmer  User    @relation("FarmerOrders", fields: [farmerId], references: [id])
  buyer   User    @relation("BuyerOrders", fields: [buyerId], references: [id])
  offer   Offer?  @relation(fields: [offerId], references: [id])
  delivery Delivery?
  transportRequests DeliveryRequest[]

  @@index([farmerId, status])
  @@index([buyerId, status])
}

// Reference prices are never presented as live transaction prices. Rows come
// from the official Agmarknet feed only; `source` records the agency and the
// report date, and an empty table means "no quotation loaded" rather than an
// invented number.
model PriceReference {
  id         String   @id @default(uuid())
  commodity  String
  market     String
  district   String
  state      String
  // Empty string rather than null so the compound unique key stays usable.
  variety    String   @default("")
  minPrice   Float
  maxPrice   Float
  modalPrice Float
  unit       String   @default("quintal")
  reportDate DateTime
  source     String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([commodity, market, variety, reportDate])
  @@index([commodity, reportDate])
}

model DeliveryRequest {
  id            String   @id @default(uuid())
  orderId       String?
  listingId     String?
  requesterId   String
  pickupLocation String
  dropLocation  String
  distanceKm    Float?
  quantityKg    Float
  pickupAt      DateTime?
  status        String   @default("REQUESTED") // REQUESTED | QUOTED | ASSIGNED | PICKUP_SCHEDULED | PICKED_UP | IN_TRANSIT | DELIVERED | CANCELLED
  notes         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  requester User            @relation(fields: [requesterId], references: [id], onDelete: Cascade)
  listing   Listing?        @relation(fields: [listingId], references: [id])
  order     Order?          @relation(fields: [orderId], references: [id])
  quotes    DeliveryQuote[]
  delivery  Delivery?

  @@index([status])
  @@index([orderId])
}

model DeliveryQuote {
  id         String   @id @default(uuid())
  requestId  String
  transporterId String
  amount     Float
  etaHours   Float?
  message    String?
  status     String   @default("PENDING") // PENDING | SELECTED | DECLINED
  createdAt  DateTime @default(now())

  request     DeliveryRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  transporter User            @relation(fields: [transporterId], references: [id], onDelete: Cascade)

  @@index([requestId])
}

model Delivery {
  id          String   @id @default(uuid())
  requestId   String   @unique
  orderId     String?  @unique
  transporterId String
  amount      Float
  status      String   @default("ASSIGNED")
  lastKnownLocation String?
  statusNote  String?
  pickedUpAt  DateTime?
  deliveredAt DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  request     DeliveryRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  order       Order?          @relation(fields: [orderId], references: [id])
  transporter User            @relation("TransporterDeliveries", fields: [transporterId], references: [id])

  @@index([transporterId, status])
}

model Notification {
  id        String   @id @default(uuid())
  userId    String
  type      String // OFFER_NEW | OFFER_COUNTER | OFFER_ACCEPTED | OFFER_REJECTED | BID_NEW | AUCTION_CLOSING | ORDER_CONFIRMED | DELIVERY_UPDATE
  title     String
  body      String
  href      String?
  readAt    DateTime?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, readAt])
}

model VoiceSession {
  id        String   @id @default(uuid())
  userId    String
  kind      String // LISTING | SEARCH | OFFER
  transcript String
  language  String   @default("auto")
  parsed    String? // JSON
  provider  String   @default("rules")
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model AuditLog {
  id        String   @id @default(uuid())
  actorId   String?
  action    String
  entity    String
  entityId  String?
  metadata  String? // JSON
  ip        String?
  createdAt DateTime @default(now())

  actor User? @relation(fields: [actorId], references: [id])

  @@index([entity, entityId])
  @@index([createdAt])
}

model Session {
  id        String   @id @default(uuid())
  userId    String
  token     String   @unique
  userAgent String?
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}
