{
  "name": "Mandi Relay — Voice-first agricultural marketplace",
  "short_name": "Mandi Relay",
  "description": "Speak what you have harvested. Discover nearby buyers, compare offers and sell smarter. A voice-first produce marketplace for India.",
  "id": "/",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "display_override": ["standalone", "minimal-ui"],
  "orientation": "portrait-primary",
  "background_color": "#F5F3EC",
