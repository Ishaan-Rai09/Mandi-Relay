# =====================================================================
# Mandi Relay — environment contract
# =====================================================================
# Copy to .env and fill in. Nothing here is committed; .env is ignored.
# A blank value means "not configured": the app still runs and the affected
# screen says so instead of showing invented data.

# ── 1. Database (required) ───────────────────────────────────────────
# Postgres is the only database. Supabase dashboard → Project Settings →
# Database → Connection string. Use the pooled port (6543) for the app and
# the direct port (5432) for `prisma db push` / `prisma migrate deploy`.
DATABASE_URL="postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true"
# Local development without a Supabase project:
#   npm run db:local   (Postgres 16 in Docker on port 5433)
# DATABASE_URL="postgresql://postgres:mandi@localhost:5433/mandi"

# ── 2. Supabase authentication, phone number + one-time code ─────────
# Authentication → Providers → Phone must be enabled, with an SMS provider
# (Twilio, MessageBird, Vonage or Textlocal) configured in Supabase.
# Without those two values the app falls back to the local development
# provider (password + database session) and says so on /auth.
NEXT_PUBLIC_SUPABASE_URL="https://<project-ref>.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="<anon public key>"

# ── 3. Administrators ────────────────────────────────────────────────
# Comma-separated phone numbers that become ADMIN on first sign-in. Roles
# are never taken from the client and no admin is seeded, so this is the
# only way to create an operator account.
ADMIN_PHONE_NUMBERS=""

# ── 4. Voice: Gnani (Vachana) speech-to-text ─────────────────────────
# The browser records, resamples to 16 kHz mono WAV and posts to
# /api/voice/transcribe. The key never reaches the client.
# Create the key at app.gnani.ai/voice — no approval step, and the same key
# covers Gnani's STT and TTS. Without it the route answers 503 and the
# interface asks the farmer to type instead.
GNANI_API_KEY=""
# GNANI_STT_URL="https://api.vachana.ai/stt/v3"
# "gnani" (default) uses the Gnani proxy; "browser" uses the Web Speech API,
# which needs no key but only works in Chromium browsers.
# NEXT_PUBLIC_STT_PROVIDER="gnani"

# ── 5. Official market price feed (Agmarknet via data.gov.in) ────────
# Free key from https://data.gov.in. Ingestion:  npm run prices:sync
# Rows land in PriceReference with the official source and report date.
AGMARKNET_API_KEY=""
# AGMARKNET_STATE="Punjab"
# AGMARKNET_BASE_URL="https://api.data.gov.in/resource/9ef84268-d588-465a-a308-a864a43d0070"
# Shared secret for POST /api/market-prices/sync from a scheduler.
# An admin session also works, so this is only needed for automation.
MARKET_PRICES_SYNC_SECRET=""

# ── 6. App URL ───────────────────────────────────────────────────────
# Absolute origin used for canonical/OG metadata.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# ── 7. Feature switches ──────────────────────────────────────────────
# Live auctions are paused. Set to "true" to bring the section back.
NEXT_PUBLIC_ENABLE_AUCTIONS="false"

# ── 8. Listing extraction (optional) ─────────────────────────────────
# "rules"  = deterministic multilingual parser (no key, no network, free)
# "llm"    = OpenAI-compatible chat completions with strict JSON validation
AI_PROVIDER="rules"
# Nvidia NIM (OpenAI-compatible, free trial tier): build.nvidia.com -> API Keys
# AI_PROVIDER="llm"
# AI_BASE_URL="https://integrate.api.nvidia.com/v1"
# AI_API_KEY="nvapi-..."
# AI_MODEL="openai/gpt-oss-120b"
# Any OpenAI-compatible endpoint works just as well:
# AI_BASE_URL="https://api.openai.com/v1"
# AI_API_KEY="sk-..."
# AI_MODEL="gpt-4o-mini"

# ── Not needed ───────────────────────────────────────────────────────
# No SESSION_SECRET: sessions are database rows with random 256-bit tokens.
# No map key: the marketplace map is a schematic render, not a tile service.
# NODE_ENV is set by Next itself — never set it here.
