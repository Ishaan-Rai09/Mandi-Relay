# =====================================================================
# Mandi Relay — environment contract
# =====================================================================
# Nothing in this file is required to run the prototype locally. Every
# external service is optional and the app degrades to a working local
# provider when its keys are absent. Never commit real keys.

# ── Database ─────────────────────────────────────────────────────────
# Local default: SQLite file managed by Prisma.
DATABASE_URL="file:./dev.db"
# Production: Supabase Postgres (apply supabase/schema.sql first).
# DATABASE_URL="postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true"

# ── Session ──────────────────────────────────────────────────────────
# 32+ random bytes. Only used by the local credential provider.
SESSION_SECRET="replace-with-openssl-rand-hex-32"

# ── AI listing / search extraction ───────────────────────────────────
# "rules"  = deterministic multilingual parser (no key, no network, free)
# "llm"    = OpenAI-compatible chat completions with strict JSON validation
AI_PROVIDER="rules"
# AI_BASE_URL="https://api.openai.com/v1"
# AI_API_KEY="sk-..."
# AI_MODEL="gpt-4o-mini"

# ── Speech ───────────────────────────────────────────────────────────
# Browser provider uses the Web Speech API (Chrome) and SpeechSynthesis.
# Set to "server" to proxy a cloud STT/TTS vendor through /api/voice/*.
NEXT_PUBLIC_STT_PROVIDER="browser"
NEXT_PUBLIC_TTS_PROVIDER="browser"

# ── Maps ─────────────────────────────────────────────────────────────
# "static" renders the built-in schematic map (real coordinates, drawn base).
# "mapbox" is the seam for a licensed basemap.
NEXT_PUBLIC_MAP_PROVIDER="static"
# NEXT_PUBLIC_MAPBOX_TOKEN="pk..."

# ── Supabase (production authentication and storage) ─────────────────
# NEXT_PUBLIC_SUPABASE_URL="https://<ref>.supabase.co"
# NEXT_PUBLIC_SUPABASE_ANON_KEY="..."
# SUPABASE_SERVICE_ROLE_KEY=""   # server-only, never exposed to the client

# ── App ──────────────────────────────────────────────────────────────
# Used for absolute URLs in metadata and the PWA manifest.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# ── Official market price feed (optional) ────────────────────────────
# When set, the ingestion job writes `market_prices` rows with is_sample=false
# and the feed's own market/report date.
# AGMARKNET_API_KEY=""
# AGMARKNET_BASE_URL="https://api.data.gov.in/resource/9ef84268-d588-465a-a308-a864a43d0070"
